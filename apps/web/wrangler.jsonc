/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ti-broish-web-staging",
	"account_id": "579692914a155ab268c22b814cbf8a05",
	"compatibility_date": "2026-09-26",
	"workers_dev": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ti-broish-signup-staging",
			"database_id": "9625b7ab-b6a0-474a-9fa7-2d9bfd1ca6e7"
		}
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"env": {
		// Workers Builds must set CLOUDFLARE_ENV=production before `pnpm build`.
		// The Vite plugin flattens this file, so a later `--env production` still deploys the top-level database.
		"production": {
			"name": "ti-broish-web",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [
				{
					"pattern": "tibroish.bg",
					"custom_domain": true
				},
				{
					"pattern": "www.tibroish.bg",
					"custom_domain": true
				},
				{
					"pattern": "next.tibroish.bg",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ti-broish-signup",
					"database_id": "5b90fdfb-3a28-4b3d-bbcf-e82cc786f8f5"
				}
			],
			"send_email": [
				{
					"name": "EMAIL"
				}
			]
		}
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// Secrets (set via CLI, do not commit values):
	//   wrangler secret put BREVO_API_KEY
	// Optional vars after the key exists:
	//   BREVO_LIST_ID, BREVO_TEMPLATE_ID, BREVO_SENDER_EMAIL, BREVO_SENDER_NAME
	// "vars": {  "BREVO_LIST_ID": "123", "BREVO_TEMPLATE_ID": "456", "BREVO_SENDER_EMAIL": "noreply@tibroish.bg", "BREVO_SENDER_NAME": "Ти Броиш" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
