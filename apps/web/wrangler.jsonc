/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ti-broish-web-staging",
	"account_id": "579692914a155ab268c22b814cbf8a05",
	"compatibility_date": "2026-09-26",
	"workers_dev": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// РИК registers sync (src/signup/rik). Staging has no cron; production reads every РИК hourly at :07,
	// each РИК at most every ~2 h (MIN_INTERVAL_MINUTES). Cron Triggers run in UTC.
	"triggers": { "crons": [] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ti-broish-signup-staging",
			"database_id": "9625b7ab-b6a0-474a-9fa7-2d9bfd1ca6e7"
		},
		{
			"binding": "CMS",
			"database_name": "ti-broish-cms-staging",
			"database_id": "a2871feb-080e-46d7-baa8-d989a70babc0"
		}
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	// Staging Brevo settings. Vars are not inherited by env.production, which has its own below.
	// BREVO_LIST_ID 94 is the empty test list „ТЕСТ ti-broish staging“. BREVO_API_KEY is a secret.
	"vars": {
		"BREVO_LIST_ID": "94",
		"BREVO_SENDER_EMAIL": "team@tibroish.bg",
		"BREVO_SENDER_NAME": "Ти броиш",
		// Drive folder „ТЕСТ пълномощни staging“. Share it with the service account (Editor).
		"DESIGNATION_DRIVE_FOLDER_ID": "14Iw8TBaKKLNa357xDy8PDunhFOloulPb",
		// /photos/<key> proxies the public MinIO photos bucket through this proxied origin host (infra/photos).
		"PHOTOS_ORIGIN": "https://minio-origin.tibroish.bg"
	},
	"env": {
		// Workers Builds must set CLOUDFLARE_ENV=production before `pnpm build`.
		// The Vite plugin flattens this file, so a later `--env production` still deploys the top-level database.
		"production": {
			"name": "ti-broish-web",
			"workers_dev": false,
			"preview_urls": false,
			"triggers": { "crons": ["7 * * * *"] },
			"routes": [
				{ "pattern": "tibroish.bg/*", "zone_name": "tibroish.bg" },
				{ "pattern": "www.tibroish.bg/*", "zone_name": "tibroish.bg" }
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ti-broish-signup",
					"database_id": "5b90fdfb-3a28-4b3d-bbcf-e82cc786f8f5"
				},
				{
					"binding": "CMS",
					"database_name": "ti-broish-cms",
					"database_id": "cd640c59-8cb4-4e34-b664-b51a12c80d18"
				}
			],
			"send_email": [
				{
					"name": "EMAIL"
				}
			],
			// Production Brevo settings. List 95 is „Представители със секция ПВР 2026“. BREVO_API_KEY is a secret.
			// DESIGNATION_DRIVE_FOLDER_ID must be set for production (do not reuse the staging folder id).
			"vars": {
				"BREVO_LIST_ID": "95",
				"BREVO_SENDER_EMAIL": "team@tibroish.bg",
				"BREVO_SENDER_NAME": "Ти броиш",
				"PHOTOS_ORIGIN": "https://minio-origin.tibroish.bg"
			}
		}
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// Secrets (set via CLI, do not commit values):
	//   wrangler secret put BREVO_API_KEY
	// Optional vars after the key exists:
	//   BREVO_LIST_ID, BREVO_TEMPLATE_ID, BREVO_SENDER_EMAIL, BREVO_SENDER_NAME
	// Designation PDF preview (grantor is personal data — secrets, never vars in git):
	//   wrangler secret put DESIGNATION_GRANTOR_NAME
	//   wrangler secret put DESIGNATION_GRANTOR_EGN
	//   wrangler secret put DESIGNATION_PRINCIPAL_NAME
	//   wrangler secret put DESIGNATION_PRINCIPAL_EGN
	// Optional: DESIGNATION_GRANTOR_AUTHORISATION, DESIGNATION_GRANTOR_CAPACITY,
	//   DESIGNATION_VALID_UNTIL, DESIGNATION_SEAL_LINE, DESIGNATION_ISSUED_ON,
	//   DESIGNATION_NUMBER_PREFIX, BREVO_DESIGNATION_ATTRIBUTE
	// Bulk signed PDFs (admin /admin/palnomoshtni):
	//   wrangler secret put GOOGLE_SERVICE_ACCOUNT_JSON
	//   wrangler secret put GOOGLE_SERVICE_ACCOUNT_JSON --env production
	//   Optional OAuth instead of the JSON: GOOGLE_OAUTH_CLIENT_ID / SECRET / REFRESH_TOKEN
	//   DESIGNATION_DRIVE_FOLDER_ID (staging var below; set for production), or DRIVE_FOLDER_ID
	//   Optional GOOGLE_DRIVE_SCOPE (default https://www.googleapis.com/auth/drive)
	// "vars": {  "BREVO_LIST_ID": "123", "BREVO_TEMPLATE_ID": "456", "BREVO_SENDER_EMAIL": "team@tibroish.bg", "BREVO_SENDER_NAME": "Ти броиш" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
